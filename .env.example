# ===== Среда =====
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ===== PostgreSQL / Redis (совпадает с docker-compose) =====
POSTGRES_USER=content_hub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=content_hub
DATABASE_URL=postgresql+asyncpg://content_hub:change_me@postgres:5432/content_hub
REDIS_URL=redis://redis:6379/0

# ===== Telegram: ЧТЕНИЕ ИСТОЧНИКОВ (отдельный аккаунт, не основной личный!) =====
# Получить на my.telegram.org для отдельного аккаунта-читателя
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
READER_SESSION_PATH=sessions/reader
READER_POLL_INTERVAL_SEC=30
# Первичный ограниченный бэкфил истории при подключении источника
READER_BACKFILL_LIMIT=20

# ===== Политика свежести постов =====
# В работу берутся посты не старше окна свежести.
# Если за окно постов не было — последние READER_FALLBACK_COUNT,
# но не старше READER_FALLBACK_MAX_AGE_HOURS.
READER_FRESH_WINDOW_MIN=60
READER_FALLBACK_COUNT=2
READER_FALLBACK_MAX_AGE_HOURS=48

# ===== Telegram: БОТ (публикация + ревью) =====
BOT_TOKEN=123456:placeholder
# Telegram user id владельца, формат JSON-списка
ALLOWED_OWNER_IDS=[111111111]

# ===== OpenRouter =====
OPENROUTER_API_KEY=sk-or-placeholder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Модели по умолчанию. Слаги переопределяются без рестарта через
# таблицу app_settings / раздел настроек админки (этап 6).
PREFILTER_MODEL=deepseek/deepseek-v4-flash-0731
CLASSIFY_MODEL=deepseek/deepseek-v4-flash-0731
# ВНИМАНИЕ: уточните точный слаг модели на OpenRouter и замените при несовпадении
REWRITE_MODEL=openai/gpt-5.6-luna
# Пусто = использовать REWRITE_MODEL
REVISION_MODEL=

# Предпочтения провайдеров (необязательно, JSON). Пусто = OpenRouter балансирует сам.
# Объект передаётся в OpenRouter как есть; поддерживаются поля:
#   order            — приоритетный список слагов провайдеров
#   only             — жёсткий белый список слагов
#   ignore           — слаги, которые нужно пропустить
#   allow_fallbacks  — фолбэк на остальных провайдеров (по умолчанию true)
#   sort             — price | throughput | latency
#   quantizations    — фильтр квантований (для open-weight моделей): ["fp8","int8",...]
#
# Примеры:
#   приоритет и ротация:   {"order": ["openai", "azure", "amazon-bedrock/us-east-1"], "allow_fallbacks": true}
#   жёсткая привязка:      {"only": ["openai"], "allow_fallbacks": false}
#   только flex-тир:       {"order": ["openai/flex"], "allow_fallbacks": false}
CLASSIFY_PROVIDERS={"order": ["deepseek"], "allow_fallbacks": true}
REWRITE_PROVIDERS={"order": ["openai", "azure"], "allow_fallbacks": true}

# ===== Предохранители =====
# Пауза пайплайна до следующего дня при превышении (посты ждут в очереди, не теряются)
MAX_LLM_BUDGET_USD_PER_DAY=1.00
# Не больше такого числа кандидатов в день уходит на ревью
MAX_CANDIDATES_PER_DAY=30

# ===== Пути =====
MEDIA_DIR=media

# ===== Админка (реализация этапа 6, задать заранее) =====
ADMIN_PASSWORD=change_me

# ===== Предфильтр (Этап 2) =====
# Текст короче этой длины (в нормализованном виде) не проходит к LLM.
# Пост с медиа и коротким текстом не отклоняется, а уходит на визуальное ревью.
PREFILTER_MIN_TEXT_LEN=200
# Глобальный чёрный список (JSON-список, регистр не важен).
# Источник может дополнить список через sources.filters -> blacklist_words.
PREFILTER_BLACKLIST_WORDS=[]

# Часовой пояс владельца: расписание, тихие часы и лимит «публикаций в день»
# считаются в нём. Пример: Europe/Moscow
OWNER_TIMEZONE=UTC
